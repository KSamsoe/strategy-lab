# --- GovGreed (official API) -------------------------------------------------
# Key is shown once at issuance. Never commit the real value.
GOVGREED_API_KEY=
GOVGREED_BASE_URL=https://www.govgreed.com/api/v1

# --- Alpaca ------------------------------------------------------------------
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# paper endpoint is the default and the only one M3 should point at
ALPACA_PAPER=true

# --- Agent layer: which backend spends what ----------------------------------
# Three backends, one request/response shape. Pick by how you want to pay.
#
#   auto         try anthropic, then claude_code, then openai; first one that
#                can actually run wins. The default. It logs which it picked and
#                what it skipped, because a loop quietly switching from an API
#                key to your subscription is not a surprise anyone should get.
#   anthropic    the Messages API on ANTHROPIC_API_KEY. Can force a tool schema,
#                so a well-formed decision is close to guaranteed.
#   claude_code  the `claude -p` CLI, billed to your Claude *subscription*.
#                NO API KEY IS NEEDED OR USED — the CLI carries its own login
#                (`claude login`), so this is the zero-marginal-cost path. In
#                exchange: a few seconds of process startup per call, and it
#                cannot force a tool schema (the schema is prompted and the JSON
#                parsed back out). Fine for `lab agent author`, wrong for
#                anything that needs a decision every few seconds.
#   openai       any OpenAI-compatible /chat/completions endpoint: OpenRouter,
#                OpenAI, LM Studio, Ollama, vLLM, Together, Groq.
LAB_AGENT_PROVIDER=auto

# The model id is NOT portable across backends — same model, three spellings:
#   anthropic / claude_code   claude-sonnet-5
#   openai via OpenRouter     anthropic/claude-sonnet-4.5
#   openai via a local server whatever the runtime calls it, e.g. qwen2.5-32b-instruct
# An id the price table does not know is billed at the most expensive tier on
# purpose, so a budget can be over-estimated but never silently blown.
LAB_AGENT_MODEL=claude-sonnet-5

# Only read by the `openai` backend, and it is what selects the vendor:
#   OpenRouter   https://openrouter.ai/api/v1     (the default when a key is set)
#   OpenAI       https://api.openai.com/v1
#   LM Studio    http://localhost:1234/v1
#   Ollama       http://localhost:11434/v1
#   vLLM         http://localhost:8000/v1
# A localhost URL is allowed to have no key at all, since local runtimes want none.
LAB_AGENT_BASE_URL=

# Keys. LAB_AGENT_API_KEY overrides both of the others and exists for endpoints
# that are neither (Together, Groq, a vLLM box behind a token).
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LAB_AGENT_API_KEY=

# OpenRouter attribution headers. Cosmetic — they decide how this shows up on
# their dashboard and leaderboards — but OpenRouter also returns the real
# per-call cost, which the ledger records instead of a price-table estimate.
OPENROUTER_REFERER=
OPENROUTER_TITLE=

# Where to find the Claude Code CLI if it is not plain `claude` on PATH.
LAB_CLAUDE_BIN=claude

# `lab agent providers` prints all of the above resolved, and says why any
# backend cannot run. Add --probe to spend one token proving it really works.

# --- Lab ---------------------------------------------------------------------
LAB_DATA_DIR=data
LAB_RUNS_DIR=runs
# Kill switch: set to 1 (or create the sentinel file) to stop all new orders.
LAB_KILL_SWITCH=0
LAB_KILL_FILE=data/KILL
LAB_ALERT_WEBHOOK=
# Optional bearer token for `lab ui` when reaching it from another LAN machine
LAB_UI_TOKEN=
